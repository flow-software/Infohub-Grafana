{
  "uid": "infohub-attribute-overview",
  "title": "Infohub: measures by attribute",
  "description": "One dashboard for every line, site or area: pick a model attribute and its values to see the measures that carry them.",
  "tags": ["flow"],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Infohub",
        "type": "datasource",
        "query": "flowsoftware-infohub-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "name": "attribute",
        "label": "Attribute",
        "type": "query",
        "datasource": {
          "type": "flowsoftware-infohub-datasource",
          "uid": "${ds}"
        },
        "query": {
          "variableKind": "attributeNames",
          "refId": "attribute",
          "queryType": "variable"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "sort": 0,
        "options": [],
        "current": {}
      },
      {
        "name": "value",
        "label": "Value",
        "type": "query",
        "datasource": {
          "type": "flowsoftware-infohub-datasource",
          "uid": "${ds}"
        },
        "query": {
          "variableKind": "attributeValues",
          "variableAttribute": "$attribute",
          "refId": "value",
          "queryType": "variable"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "sort": 0,
        "options": [],
        "current": {}
      },
      {
        "name": "measure",
        "label": "Measures",
        "type": "query",
        "datasource": {
          "type": "flowsoftware-infohub-datasource",
          "uid": "${ds}"
        },
        "query": {
          "variableKind": "measures",
          "attributeFilter": "$attribute",
          "attributeValues": ["$value"],
          "refId": "measure",
          "queryType": "variable"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "sort": 0,
        "options": [],
        "current": {
          "text": ["All"],
          "value": ["$__all"]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Pick a model **Attribute** (the attributes set up on measures in Flow, e.g. Line or Site) and one or more of its **Values**. **Measures** then lists the measures that carry those values; leave it on All or narrow it down. Both panels follow it."
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Measures where ${attribute} = ${value:text}",
      "description": "Measures tab with the Measures variable; the variable lists measures by attribute.",
      "datasource": {
        "type": "flowsoftware-infohub-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "measureVariable": "$measure",
          "items": [],
          "legend": "{{path}}",
          "refId": "A",
          "datasource": {
            "type": "flowsoftware-infohub-datasource",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "table",
      "title": "Latest values",
      "description": "",
      "datasource": {
        "type": "flowsoftware-infohub-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "measureVariable": "$measure",
          "items": [],
          "legend": "{{path}}",
          "refId": "A",
          "datasource": {
            "type": "flowsoftware-infohub-datasource",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": ["lastNotNull", "min", "max", "mean"],
            "mode": "seriesToRows",
            "includeTimeField": false
          }
        }
      ],
      "id": 3
    }
  ]
}
