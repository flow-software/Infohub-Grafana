{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "Infohub by Flow",
  "id": "flowsoftware-flow-datasource",
  "metrics": true,
  "alerting": true,
  "annotations": true,
  "backend": true,
  "executable": "gpx_flow",
  "info": {
    "description": "Browse the Flow model by folder and metric and chart measure and tag data, for model measures or every instance of a template measure.",
    "author": {
      "name": "Flow Software",
      "url": "https://www.flow-software.com"
    },
    "keywords": ["datasource", "flow", "kpi", "manufacturing", "industrial", "iiot", "time series"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [{ "name": "Flow Software", "url": "https://www.flow-software.com" }],
    "screenshots": [
      { "name": "Measures with limits and comments", "path": "img/screenshots/measures.png" },
      { "name": "Query editor", "path": "img/screenshots/editor.png" },
      { "name": "Dependency graph", "path": "img/screenshots/dependencies.png" },
      { "name": "Event periods", "path": "img/screenshots/events.png" },
      { "name": "Measures per event period", "path": "img/screenshots/event-context.png" },
      { "name": "Flow chart", "path": "img/screenshots/chart.png" },
      { "name": "Measures by attribute", "path": "img/screenshots/attributes.png" }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    { "type": "dashboard", "name": "Flow: measure explorer", "path": "dashboards/measure-explorer.json" },
    { "type": "dashboard", "name": "Flow: measures by attribute", "path": "dashboards/attribute-overview.json" },
    { "type": "dashboard", "name": "Flow: event analysis", "path": "dashboards/event-analysis.json" },
    { "type": "dashboard", "name": "Flow: chart viewer", "path": "dashboards/chart-viewer.json" }
  ],
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  }
}
